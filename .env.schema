# Grok Build App — secrets schema for HQ (`hq run` / `hq secrets exec`)
# Values live in the company vault; never commit real secrets.

# Required for default xAI / Grok routing
XAI_API_KEY:

# Optional providers
OPENAI_API_KEY:
ANTHROPIC_API_KEY:
GOOGLE_API_KEY:
OPENROUTER_API_KEY:
OLLAMA_API_KEY:

# LAN bind protection (required only when hostname is not loopback)
OPENCODEX_API_AUTH_TOKEN:
GBA_API_AUTH_TOKEN:
